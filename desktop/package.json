{
  "name": "@composer/desktop",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:electron": "concurrently -k \"npm:start\" \"wait-on tcp:4200 && COMPOSER_DEV_SERVER_URL=http://localhost:4200 electron .\"",
    "start:electron:debug": "concurrently -k \"npm:start\" \"wait-on tcp:4200 && COMPOSER_DEV_SERVER_URL=http://localhost:4200 COMPOSER_DEBUG_PORT=9222 electron .\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "main": "electron/main.js",
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "lucide-angular": "^1.0.0",
    "marked": "^18.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}