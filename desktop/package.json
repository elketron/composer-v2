{
  "name": "@composer/desktop",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:electron": "concurrently -k \"npm:start\" \"wait-on tcp:4200 && COMPOSER_DEV_SERVER_URL=http://localhost:4200 electron .\"",
    "start:electron:debug": "concurrently -k \"npm:start\" \"wait-on tcp:4200 && COMPOSER_DEV_SERVER_URL=http://localhost:4200 COMPOSER_DEBUG_PORT=9222 electron .\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test && npm run test:gateway",
    "test:gateway": "vitest run --config vitest.node.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "prepare:server": "node scripts/prepare-server.mjs",
    "dist": "npm run build && npm run icons && npm run prepare:server && electron-builder --publish never",
    "dist:linux": "npm run build && npm run icons && npm run prepare:server && electron-builder --linux --publish never",
    "dist:win": "npm run build && npm run icons && npm run prepare:server && electron-builder --win --publish never"
  },
  "main": "electron/main.js",
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@foblex/flow": "^19.1.7",
    "dagre": "^0.8.5",
    "diff2html": "^3.4.56",
    "lucide-angular": "^1.0.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "description": "Composer: the desktop command center for the composer event backbone.",
  "author": {
    "name": "composer",
    "url": "https://composer.dev"
  },
  "executableName": "composer",
  "desktopName": "composer.desktop",
  "homepage": "https://composer.dev"
}
